# Copy into the build folder. Workers static assets default to
# `max-age=0, must-revalidate` on everything (traps.md 18). HTML keeps that default:
# it is small and names the versioned assets below.
# Patterns must not overlap: a header matched twice is comma-joined.

# Fingerprinted by the build (?v=<content hash> changes with the bytes).
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

# Media keeps stable names, so 30 days and no `immutable`. Rename or purge on change.
/media/*
  Cache-Control: public, max-age=2592000

/wp-content/*
  Cache-Control: public, max-age=2592000

/favicon.ico
  Cache-Control: public, max-age=2592000
